# ============================================================
# Quizzy - Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# PostgreSQL Database (get a free DB at https://neon.tech or https://supabase.com)
DATABASE_URL=postgresql://username:password@your-db-host.neon.tech/quizzy?sslmode=require

# Auth Secret (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=replace_with_a_random_64_char_hex_string

# Google Gemini AI API Key (get free key at https://aistudio.google.com/apikey)
GEMINI_API_KEY=AIzaSy_replace_with_your_key

# Server port (default: 5000 for API, 5173 for frontend dev)
PORT=5000

# Node environment
NODE_ENV=development

# Google OAuth Client ID
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Resend Email Service API Key (get free key at https://resend.com/api-keys)
RESEND_API_KEY=re_your_resend_api_key

# Gmail SMTP Email Service (optional alternative to Resend: 16-char App Password from https://myaccount.google.com/apppasswords)
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_google_app_password


